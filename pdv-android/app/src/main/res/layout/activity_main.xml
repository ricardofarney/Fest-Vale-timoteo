<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/titulo"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:paddingBottom="12dp"
        android:text="@string/subtitulo"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btAtivar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_ativar" />

    <Button
        android:id="@+id/btCobrar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_cobrar" />

    <Button
        android:id="@+id/btCobrarDebito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_cobrar_debito" />

    <Button
        android:id="@+id/btImprimir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bt_imprimir" />

    <ScrollView
        android:id="@+id/rolagem"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/saida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>
</LinearLayout>
