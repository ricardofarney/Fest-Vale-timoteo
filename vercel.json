{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && cp dist/client/_shell.html dist/client/index.html",
  "outputDirectory": "dist/client",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/pdv",
      "destination": "https://dwynfydbtkwwppwblkbu.supabase.co/rest/v1/rpc/pdv_api"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
